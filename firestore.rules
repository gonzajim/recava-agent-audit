rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: usuario autenticado con email verificado
    function isVerifiedUser() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    // Helper: el uid del documento coincide con el del solicitante
    function isOwner() {
      return resource.data.uid == request.auth.uid;
    }

    // ---------- audit_progress ----------
    // Solo el propietario puede leer/escribir su progreso de auditoría
    match /audit_progress/{threadId} {
      allow get: if isVerifiedUser() && isOwner();
      allow create: if isVerifiedUser()
                    && request.resource.data.uid == request.auth.uid;
      allow update: if isVerifiedUser() && isOwner()
                    && request.resource.data.uid == resource.data.uid;
      allow delete: if false; // No se permite borrar desde el cliente
    }

    // ---------- empirical_audits ----------
    match /empirical_audits/{auditId} {
      // Para entorno local y pruebas, permitimos lectura libre
      allow read: if true;
      allow create, update: if isVerifiedUser()
                    && request.resource.data.uid == request.auth.uid;
      allow delete: if false;
    }

    // ---------- threads ----------
    // Solo el propietario puede leer/crear su thread
    match /threads/{threadId} {
      allow get: if isVerifiedUser() && isOwner();
      allow create: if isVerifiedUser()
                    && request.resource.data.uid == request.auth.uid;
      allow update: if isVerifiedUser() && isOwner()
                    && request.resource.data.uid == resource.data.uid;
      allow delete: if false;
    }

    // Colección interna de health check — sin acceso desde clientes
    match /_ready/{docId} {
      allow read, write: if false;
    }

    // Cualquier otra colección: denegado por defecto
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
